<UserControl x:Class="HealthNote.Desktop.Views.TrendView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="지표 추이" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
            <TextBlock Text="같은 지표와 단위의 측정값을 표에서 탐색해요." Style="{DynamicResource Caption}" Margin="0,6,0,0" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,20">
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="지표" Style="{DynamicResource Caption}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric, Mode=TwoWay}" MinWidth="140" AutomationProperties.Name="측정 지표" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="선택한 측정" Style="{DynamicResource Caption}" />
                <TextBlock x:Name="SelectedValue" Text="{Binding Selected.DisplayValue, TargetNullValue=측정 선택 없음}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Selected.Date}" Style="{DynamicResource Caption}" />
            </StackPanel>
        </WrapPanel>
        <Border Grid.Row="2" Style="{DynamicResource Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Metric, StringFormat={}{0} · kg}" Style="{DynamicResource SectionTitle}" />
                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="측정 날짜" Style="{DynamicResource Caption}" />
                    <TextBlock Grid.Column="1" Text="출처" Style="{DynamicResource Caption}" />
                    <TextBlock Grid.Column="2" Text="값 (kg)" Style="{DynamicResource Caption}" TextAlignment="Right" />
                </Grid>
                <ListBox x:Name="MeasurementList" Grid.Row="2" ItemsSource="{Binding Measurements}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="측정값 표" ItemContainerStyle="{DynamicResource RecordItemStyle}" AutomationProperties.AutomationId="Measurements">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="{Binding Date}" />
                                <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Grid.Column="1" Text="{Binding Source}" Style="{DynamicResource Caption}" />
                                <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Grid.Column="2" Text="{Binding TableValue}" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock Text="{Binding Selected.Source}" Style="{DynamicResource Caption}" />
                    <TextBlock Text="결측은 0으로 표시하지 않아요. 합성 측정 자료이며 그래프는 후속 단계에서 제공합니다." Style="{DynamicResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>