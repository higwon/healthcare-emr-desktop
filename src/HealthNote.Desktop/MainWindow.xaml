<Window x:Class="HealthNote.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="건강노트 · 합성 데이터 Preview" Width="1280" Height="800" UseLayoutRounding="True" FontFamily="Segoe UI, Malgun Gothic" FontSize="{DynamicResource BodyFontSize}" Background="{DynamicResource AppBackgroundBrush}" AutomationProperties.Name="건강노트 합성 데이터 탐색">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Foundations.xaml" />
                <ResourceDictionary Source="Resources/LightTheme.xaml" />
                <ResourceDictionary Source="Resources/Controls.xaml" />
                <ResourceDictionary Source="Resources/ViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,24">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Brand}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,28" />
                <StackPanel DockPanel.Dock="Bottom" Margin="8,24,0,0">
                    <TextBlock Text="합성 데이터 데모" FontWeight="SemiBold" />
                    <TextBlock Text="실제 건강정보를 사용하지 않아요" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
                <ListBox x:Name="NavigationList" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}" VerticalAlignment="Top" AutomationProperties.Name="주요 탐색" AutomationProperties.AutomationId="Navigation">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Symbol}" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ContextTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ContextDescription}" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsEmrWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="조회 기간" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <ComboBox x:Name="PeriodSelector" ItemsSource="{Binding Periods}" SelectedItem="{Binding Period, Mode=TwoWay}" MinWidth="126" AutomationProperties.Name="조회 기간" />
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="ScreenHost" Grid.Row="1" Content="{Binding ActiveScreen}" Margin="24" />
            <Expander x:Name="ConnectionTools" Grid.Row="2" Header="연결 상태 · 개발 도구 (건강 자료 조회와 별도)" Padding="12,4" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
                <StackPanel Margin="12">
    <TextBlock Text="Timeline 합성 상태 Preview · 실제 조회/저장 없음" Style="{StaticResource Caption}" />
    <WrapPanel Margin="0,8,0,16">
        <ComboBox ItemsSource="{Binding Timeline.States}" SelectedItem="{Binding Timeline.State, Mode=TwoWay}" AutomationProperties.Name="Timeline 합성 표시 상태" Margin="0,0,12,0" />
        <CheckBox Content="Timeline 긴 제목 예시" IsChecked="{Binding Timeline.LongTitle}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
    </WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenConnection" Content="연결 상태 열기" Command="{Binding OpenConnectionCommand}" Margin="0,0,8,0" />
                        <Button x:Name="CloseConnection" Content="화면 닫기" Command="{Binding CloseConnectionCommand}" />
                    </StackPanel>
                    <ContentControl Content="{Binding Current}" Margin="0,8,0,0">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Status}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="연결 확인" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                                        <Button Content="취소" Command="{Binding CancelCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </Expander>
        </Grid>
    </Grid>
</Window>
