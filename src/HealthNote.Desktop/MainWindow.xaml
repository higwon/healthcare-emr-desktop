<Window x:Class="HealthNote.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HealthNote" Width="960" Height="640" MinWidth="640" MinHeight="400">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="HealthNote · 개발 기반" FontSize="24" />
            <TextBlock Text="HC-102 연결·명령·화면 수명 검증 / 합성 데이터 데모"
                       Margin="0,8,0,24" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="연결 상태 열기" Command="{Binding OpenConnectionCommand}"
                    Padding="16,8" Margin="0,0,8,0" />
            <Button Content="화면 닫기" Command="{Binding CloseConnectionCommand}" Padding="16,8" />
        </StackPanel>
        <ContentControl Grid.Row="2" Content="{Binding Current}" Margin="0,24,0,0">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="데모 서버 연결" FontSize="18" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="연결 확인" Command="{Binding RefreshCommand}"
                                    Padding="16,8" Margin="0,0,8,0" />
                            <Button Content="취소" Command="{Binding CancelCommand}" Padding="16,8" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</Window>
